# AWS Configuration
REACT_APP_AWS_REGION=ap-southeast-1

# S3 Configuration
REACT_APP_S3_BUCKET=treasury-documents

# Amazon Q Business Configuration
REACT_APP_QBUSINESS_APP_ID=your-qbusiness-application-id

# CloudFront Configuration
REACT_APP_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# Optional: Enable development mode features
REACT_APP_ENABLE_MOCK_DATA=false
